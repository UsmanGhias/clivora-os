<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLIVORA"
        android:textColor="@color/widget_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_outstanding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="—"
        android:textColor="@color/widget_primary_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_outstanding_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Outstanding"
        android:textColor="@color/widget_secondary_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_overdue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0 overdue"
        android:textColor="@color/widget_secondary_text"
        android:textSize="13sp" />
</LinearLayout>
