# CLIVORA Community: web app configuration.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Required -----------------------------------------------------------------
# Public address of this deployment (used for auth redirects and links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your Supabase project. For local development, run `supabase start` in the repo
# root and paste the API URL and anon key it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for features that act on behalf of the system (public
# invoice links, review tokens, job ingest). Keep it out of client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional -----------------------------------------------------------------
# Name and contact shown on public pages and in emails.
NEXT_PUBLIC_SITE_NAME=Clivora
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com

# Google sign-in and calendar (configure the same client in Supabase Auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for POST /api/v1/jobs (importing jobs from another system).
JOB_BOT_API_KEY=

# Link to your Android build's store listing, if you publish one.
NEXT_PUBLIC_PLAY_STORE_URL=

# File vault quota per user, in MB.
NEXT_PUBLIC_VAULT_LIMIT_MB=1024

# Optional full-text search for Connect (Meilisearch). Leave empty to use Postgres search.
MEILI_HOST=
MEILI_KEY=
NEXT_PUBLIC_MEILI_HOST=
NEXT_PUBLIC_MEILI_KEY=

# Alternative name for JOB_BOT_API_KEY.
CLIVORA_API_KEY=
